<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Atlas on your server, reached through Tailscale -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 1.3.0: contacts in the search, and Phone under a contact calls at once (Android asks for both the first time) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- 1.4.0: Sun mode works out the sky where you are. Approximate location only (about 2 km), asked when you pick Sun;
         the place stays on the phone. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Optional: how much each app is used, so the map can size apps by use. Granted by you in Android's settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Uninstall from an app's long press (Android always asks you to confirm) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- New versions of this launcher, from your Atlas server -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Every app with an icon is visible to the launcher (Android 11 package visibility) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Atlas"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atlas"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|fontScale|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Atlas as the Home screen. Settings, Quit switches this off so the phone goes back to its own launcher;
             opening Atlas from the apps switches it on again. -->
        <activity-alias
            android:name=".Home"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- A file from Atlas handed to another app (hold a file, Share): read only, to that app only (SharedFiles.kt) -->
        <provider
            android:name=".SharedFiles"
            android:authorities="com.vittorionetti.atlas.launcher.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
